{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Fandw",
						"type": "DatasetReference"
					},
					"name": "fandw"
				},
				{
					"dataset": {
						"referenceName": "FreedomFibre",
						"type": "DatasetReference"
					},
					"name": "freedomFibre"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "union1"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          uprn as string,",
				"          address as string,",
				"          postcode as string,",
				"          town as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['F&W/*'],",
				"     partitionBy('hash', 1)) ~> fandw",
				"source(output(",
				"          uprn as string,",
				"          postcode as string,",
				"          address as string,",
				"          town as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     wildcardPaths:['Freedom Fibre/*'],",
				"     partitionBy('hash', 1)) ~> freedomFibre",
				"fandw derive(source = \"fandw\",",
				"          source_info = '{' +\r",
				"    '\"fandw\": ' + '{' + \r",
				"        '\"uprn\": \"' + escape(uprn, 'json') + '\",' +\r",
				"        '\"address\": \"' + escape(address, 'json') + '\",' +\r",
				"        '\"postcode\": \"' + escape(postcode, 'json') + '\",' +\r",
				"        '\"town\": \"' + escape(town, 'json') + '\"' +\r",
				"    '}' +\r",
				"'}') ~> derivedColumn1",
				"freedomFibre derive(source = \"freedomFibre\",",
				"          source_info = '{' +\r",
				"    '\"freedomFibre\": ' + '{' + \r",
				"        '\"uprn\": \"' + escape(uprn, 'json') + '\",' +\r",
				"        '\"address\": \"' + escape(address, 'json') + '\",' +\r",
				"        '\"postcode\": \"' + escape(postcode, 'json') + '\",' +\r",
				"        '\"town\": \"' + escape(town, 'json') + '\"' +\r",
				"    '}' +\r",
				"'}') ~> derivedColumn2",
				"derivedColumn1, derivedColumn2 union(byName: true,",
				"     partitionBy('hash', 1))~> union1",
				"union1 aggregate(groupBy(uprn),",
				"     postcode = first(postcode),",
				"          source = collect(source),",
				"     partitionBy('hash', 1)) ~> aggregate1"
			]
		}
	}
}