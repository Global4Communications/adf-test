{
	"name": "BlobToMysql",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Fandw",
						"type": "DatasetReference"
					},
					"name": "SourceFandw"
				},
				{
					"dataset": {
						"referenceName": "CityFibreDirectFile",
						"type": "DatasetReference"
					},
					"name": "SourceCityFibreDirect"
				},
				{
					"dataset": {
						"referenceName": "FreedomFibre",
						"type": "DatasetReference"
					},
					"name": "SourceFreedomFibre"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AlexTestAdm",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "select2"
				},
				{
					"name": "union1"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "select3"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          uprn as long,",
				"          address as string,",
				"          postcode as string,",
				"          town as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 1,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: '_Filename',",
				"     wildcardPaths:['F&W/*.xlsx']) ~> SourceFandw",
				"source(output(",
				"          cabinet_city as string,",
				"          secondary_node as string,",
				"          uprn as long,",
				"          full_address as string,",
				"          post_code as string,",
				"          dr_status as string,",
				"          blpu_classification as string,",
				"          installation_date as string,",
				"          property_flags as string,",
				"          demand_point_type as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: '_Filename',",
				"     wildcardPaths:['City Fibre Direct/*.csv']) ~> SourceCityFibreDirect",
				"source(output(",
				"          uprn as long,",
				"          address as string,",
				"          postcode as string,",
				"          town as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     limit: 1,",
				"     ignoreNoFilesFound: false,",
				"     rowUrlColumn: '_Filename',",
				"     wildcardPaths:['Freedom Fibre/*.xlsx']) ~> SourceFreedomFibre",
				"SourceFandw derive({_Uprn} = toInteger(uprn),",
				"          Fandw = @(uprn=uprn,",
				"          address=address,",
				"          postcode=postcode,",
				"          town=town,",
				"          {_Filename}={_Filename})) ~> derivedColumn1",
				"derivedColumn1 select(mapColumn(",
				"          {_Uprn},",
				"          Fandw",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"SourceCityFibreDirect derive({_Uprn} = toInteger(uprn),",
				"          CityFibreDirect = @(cabinet_city=cabinet_city,",
				"          secondary_node=secondary_node,",
				"          uprn=uprn,",
				"          full_address=full_address,",
				"          post_code=post_code,",
				"          dr_status=dr_status,",
				"          blpu_classification=blpu_classification,",
				"          installation_date=installation_date,",
				"          property_flags=property_flags,",
				"          demand_point_type=demand_point_type,",
				"          {_Filename}={_Filename})) ~> derivedColumn2",
				"derivedColumn2 select(mapColumn(",
				"          {_Uprn},",
				"          CityFibreDirect",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"select1, select3 union(byName: true)~> union1",
				"union1 derive({_PartitionKey} = toString(mod(toInteger({_Uprn}), 1000))) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy({_Uprn}),",
				"     each(match(regexMatch(name,'^_(?!Uprn$).*')), $$ = max($$)),",
				"          each(match(regexMatch(name,'^[^_].*')), $$ = max($$))) ~> aggregate1",
				"SourceFreedomFibre derive({_Uprn} = toInteger(uprn),",
				"          FreedomFibre = @(uprn=uprn,",
				"          address=address,",
				"          postcode=postcode,",
				"          town=town,",
				"          {_Filename}={_Filename})) ~> derivedColumn4",
				"derivedColumn4 select(mapColumn(",
				"          {_Uprn},",
				"          FreedomFibre",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"aggregate1 alterRow(upsertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     tableName: 'uprns',",
				"     deletable: true,",
				"     insertable: true,",
				"     updateable: true,",
				"     upsertable: true,",
				"     keys:['_Uprn'],",
				"     store: 'mysql',",
				"     batchSize: 1,",
				"     filePattern:'output2-[n].json',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          uprn = {_Uprn}",
				"     )) ~> sink1"
			]
		}
	}
}