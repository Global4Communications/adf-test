{
	"name": "CosmosToTable",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "CosmosDbNoSql1",
						"type": "LinkedServiceReference"
					},
					"name": "NosqlFileRows"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "OutputJson",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureBlobStorage1",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "Dedupe",
					"description": "Select distinct values.  If multiple entries for the same UPRN are found the use the latest values for each column"
				},
				{
					"name": "AdditionalColumns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          CityFibreDirect as (uprn as long, full_address as string, {_Filepath} as string, {_Filename} as string),",
				"          FreedomFibre as (uprn as long, address as string, postcode as string, town as string, {_Filepath} as string, {_Filename} as string),",
				"          Fandw as (uprn as long, address as string, postcode as string, town as string, {_Filepath} as string, {_Filename} as string),",
				"          {_PartitionKey} as string,",
				"          {_Uprn} as long",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     container: 'FileRows',",
				"     storeType: 'oltp',",
				"     format: 'document',",
				"     store: 'cosmosDB',",
				"     partitionBy('roundRobin', 6)) ~> NosqlFileRows",
				"NosqlFileRows aggregate(groupBy({_Uprn}),",
				"     each(match(regexMatch(name,'^[^_].*')), $$ = max($$))) ~> Dedupe",
				"Dedupe derive(id = {_Uprn},",
				"          PartitionKey = toString(mod({_Uprn}, 1000))) ~> AdditionalColumns",
				"AdditionalColumns sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     filePattern:'output-[n].json',",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}