{
	"name": "FreedomFibre_TableStorage",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "datafactory/F&W/"
					},
					{
						"name": "Destination",
						"value": "testCollection1"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"additionalColumns": [
							{
								"name": "_filename",
								"value": "$$FILENAME"
							},
							{
								"name": "_filepath",
								"value": "$$FILEPATH"
							},
							{
								"name": "_supplier",
								"value": "freedomFibre"
							},
							{
								"name": "_uprn",
								"value": "$$COLUMN:uprn"
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": false,
							"wildcardFolderPath": "Freedom Fibre",
							"wildcardFileName": "*.xlsx",
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "AzureTableSink",
						"azureTableInsertType": "merge",
						"azureTableDefaultPartitionKeyValue": "main",
						"writeBatchSize": 10000
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "uprn",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "uprn"
								}
							},
							{
								"source": {
									"name": "address",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "address"
								}
							},
							{
								"source": {
									"name": "postcode",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "postcode"
								}
							},
							{
								"source": {
									"name": "town",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "town"
								}
							},
							{
								"source": {
									"name": "_filename",
									"type": "String"
								},
								"sink": {
									"name": "_filename"
								}
							},
							{
								"source": {
									"name": "_filepath",
									"type": "String"
								},
								"sink": {
									"name": "_filepath"
								}
							},
							{
								"source": {
									"name": "_supplier"
								},
								"sink": {
									"name": "_supplier"
								}
							},
							{
								"source": {
									"name": "_uprn"
								},
								"sink": {
									"name": "_uprn"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "FreedomFibre",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Rfs3TableStorage",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}