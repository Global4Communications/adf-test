{
	"name": "Fandw_TableStorage_copy1",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "datafactory/F&W/"
					},
					{
						"name": "Destination",
						"value": "testCollection1"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"additionalColumns": [
							{
								"name": "_filepath",
								"value": "$$FILEPATH"
							},
							{
								"name": "_filename",
								"value": "$$FILENAME"
							},
							{
								"name": "_supplier",
								"value": "fandw"
							},
							{
								"name": "_uprn",
								"value": "$$COLUMN:uprn"
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": false,
							"wildcardFolderPath": "F&W",
							"wildcardFileName": "*.xlsx",
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "CosmosDbSqlApiSink",
						"writeBehavior": "insert"
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "uprn",
									"type": "String"
								},
								"sink": {
									"path": "$['uprn']"
								}
							},
							{
								"source": {
									"name": "address",
									"type": "String"
								},
								"sink": {
									"path": "$['address']"
								}
							},
							{
								"source": {
									"name": "postcode",
									"type": "String"
								},
								"sink": {
									"path": "$['postcode']"
								}
							},
							{
								"source": {
									"name": "town",
									"type": "String"
								},
								"sink": {
									"path": "$['town']"
								}
							},
							{
								"source": {
									"name": "_filepath",
									"type": "String"
								},
								"sink": {
									"path": "$['_filepath']"
								}
							},
							{
								"source": {
									"name": "_filename",
									"type": "String"
								},
								"sink": {
									"path": "$['_filename']"
								}
							},
							{
								"source": {
									"name": "_supplier",
									"type": "String"
								},
								"sink": {
									"path": "$['_supplier']"
								}
							},
							{
								"source": {
									"name": "_uprn",
									"type": "String"
								},
								"sink": {
									"path": "$['_uprn']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "Fandw",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Nosql",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "TestCosmosToTable"
		},
		"annotations": []
	}
}