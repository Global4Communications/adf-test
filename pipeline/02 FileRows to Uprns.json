{
	"name": "02 FileRows to Uprns",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "CosmosDbSqlApiSource",
						"preferredRegions": [],
						"detectDatetime": true
					},
					"sink": {
						"type": "AzureTableSink",
						"azureTableInsertType": "merge",
						"azureTableDefaultPartitionKeyValue": {
							"value": "@{string(rand(10000, 99999))}",
							"type": "Expression"
						},
						"azureTableRowKeyName": "_Uprn",
						"writeBatchSize": 10000
					},
					"enableStaging": false,
					"parallelCopies": 1,
					"enableSkipIncompatibleRow": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['Fandw']"
								},
								"sink": {
									"name": "Fandw"
								}
							},
							{
								"source": {
									"path": "$['_Uprn']"
								},
								"sink": {
									"name": "_Uprn"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "NosqlFileRows",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "rfsUprns",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "TestCosmosToTable"
		},
		"annotations": []
	}
}