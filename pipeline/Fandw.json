{
	"name": "Fandw",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "datafactory/F&W/"
					},
					{
						"name": "Destination",
						"value": "testCollection1"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"additionalColumns": [
							{
								"name": "_postcode",
								"value": "$$COLUMN:postcode"
							},
							{
								"name": "_uprn",
								"value": "$$COLUMN:uprn"
							},
							{
								"name": "_id",
								"value": "$$COLUMN:uprn"
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": false,
							"wildcardFolderPath": "F&W",
							"wildcardFileName": "*.xlsx",
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "CosmosDbMongoDbApiSink",
						"writeBatchTimeout": "00:00:01",
						"writeBehavior": "upsert"
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "_uprn",
									"type": "String"
								},
								"sink": {
									"path": "$['uprn']"
								}
							},
							{
								"source": {
									"name": "_id",
									"type": "String"
								},
								"sink": {
									"path": "$['_id']"
								}
							},
							{
								"source": {
									"name": "_postcode",
									"type": "String"
								},
								"sink": {
									"path": "$['postcode']"
								}
							},
							{
								"source": {
									"name": "uprn",
									"type": "String"
								},
								"sink": {
									"path": "$['sources']['fandw']['uprn']"
								}
							},
							{
								"source": {
									"name": "address",
									"type": "String"
								},
								"sink": {
									"path": "$['sources']['fandw']['address']"
								}
							},
							{
								"source": {
									"name": "postcode",
									"type": "String"
								},
								"sink": {
									"path": "$['sources']['fandw']['postcode']"
								}
							},
							{
								"source": {
									"name": "town",
									"type": "String"
								},
								"sink": {
									"path": "$['sources']['fandw']['town']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "Fandw",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "mongo_testCollection2",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}