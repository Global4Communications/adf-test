{
	"name": "01 Fandw to FileRows",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [
					{
						"name": "Source",
						"value": "datafactory/F&W/"
					},
					{
						"name": "Destination",
						"value": "testCollection1"
					}
				],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"additionalColumns": [
							{
								"name": "_Filepath",
								"value": "$$FILEPATH"
							},
							{
								"name": "_Filename",
								"value": "$$FILENAME"
							},
							{
								"name": "_Uprn",
								"value": "$$COLUMN:uprn"
							},
							{
								"name": "_PipelineRunId",
								"value": "@pipeline().RunId"
							}
						],
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": false,
							"wildcardFolderPath": "F&W",
							"wildcardFileName": "*.xlsx",
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "CosmosDbSqlApiSink",
						"writeBehavior": "insert"
					},
					"enableStaging": false,
					"enableSkipIncompatibleRow": true,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "uprn",
									"type": "String"
								},
								"sink": {
									"path": "$['Fandw']['uprn']"
								}
							},
							{
								"source": {
									"name": "address",
									"type": "String"
								},
								"sink": {
									"path": "$['Fandw']['address']"
								}
							},
							{
								"source": {
									"name": "postcode",
									"type": "String"
								},
								"sink": {
									"path": "$['Fandw']['postcode']"
								}
							},
							{
								"source": {
									"name": "town",
									"type": "String"
								},
								"sink": {
									"path": "$['Fandw']['town']"
								}
							},
							{
								"source": {
									"name": "_Filepath"
								},
								"sink": {
									"path": "$['Fandw']['_Filepath']"
								}
							},
							{
								"source": {
									"name": "_Filename"
								},
								"sink": {
									"path": "$['Fandw']['_Filename']"
								}
							},
							{
								"source": {
									"name": "_Uprn"
								},
								"sink": {
									"path": "$['_Uprn']"
								}
							},
							{
								"source": {
									"name": "_PipelineRunId"
								},
								"sink": {
									"path": "$['_PartitionKey']"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "Fandw",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "NosqlFileRows",
						"type": "DatasetReference"
					}
				]
			}
		],
		"folder": {
			"name": "TestCosmosToTable"
		},
		"annotations": []
	}
}