										}
									},
									{
										"source": {
											"name": "_id",
											"type": "String"
										},
										"sink": {
											"path": "$['_id']"
										}
									},
									{
										"source": {
											"name": "_postcode",
											"type": "String"
										},
										"sink": {
											"path": "$['postcode']"
										}
									},
									{
										"source": {
											"name": "uprn",
											"type": "String"
										},
										"sink": {
											"path": "$['sources']['fandw']['uprn']"
										}
									},
									{
										"source": {
											"name": "address",
											"type": "String"
										},
										"sink": {
											"path": "$['sources']['fandw']['address']"
										}
									},
									{
										"source": {
											"name": "postcode",
											"type": "String"
										},
										"sink": {
											"path": "$['sources']['fandw']['postcode']"
										}
									},
									{
										"source": {
											"name": "town",
											"type": "String"
										},
										"sink": {
											"path": "$['sources']['fandw']['town']"
										}
									}
								]
							}
						},
						"inputs": [
							{
								"referenceName": "Fandw",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "mongo_testCollection2",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
