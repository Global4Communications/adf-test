			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'alexTestPg'"
		},
		"alextestsa2_tableStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'alextestsa2_tableStorage'"
		},
		"CosmosDbMongoDb1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testDatabase"
		},
		"CosmosDbMongoDb2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testDatabase"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
