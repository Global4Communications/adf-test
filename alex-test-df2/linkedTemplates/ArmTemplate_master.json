{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "alex-test-df2"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"CosmosDbMongoDb1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'CosmosDbMongoDb1'"
		},
		"CosmosDbMongoDb1_account": {
			"type": "secureString",
			"metadata": "Secure string for 'account' of 'CosmosDbMongoDb1'",
			"defaultValue": "alex-test-cd"
		},
		"CosmosDbMongoDb2_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'CosmosDbMongoDb2'"
		},
		"CosmosDbMongoDb2_account": {
			"type": "secureString",
			"metadata": "Secure string for 'account' of 'CosmosDbMongoDb2'",
			"defaultValue": "alex-test-cd2"
		},
		"alexTestPg_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'alexTestPg'"
		},
		"alextestsa2_tableStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'alextestsa2_tableStorage'"
		},
		"CosmosDbMongoDb1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testDatabase"
		},
		"CosmosDbMongoDb2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "testDatabase"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "alex-test-df2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"CosmosDbMongoDb1_connectionString": {
						"value": "[parameters('CosmosDbMongoDb1_connectionString')]"
					},
					"CosmosDbMongoDb1_account": {
						"value": "[parameters('CosmosDbMongoDb1_account')]"
					},
					"CosmosDbMongoDb2_connectionString": {
						"value": "[parameters('CosmosDbMongoDb2_connectionString')]"
					},
					"CosmosDbMongoDb2_account": {
						"value": "[parameters('CosmosDbMongoDb2_account')]"
					},
					"alexTestPg_connectionString": {
						"value": "[parameters('alexTestPg_connectionString')]"
					},
					"alextestsa2_tableStorage_connectionString": {
						"value": "[parameters('alextestsa2_tableStorage_connectionString')]"
					},
					"CosmosDbMongoDb1_properties_typeProperties_database": {
						"value": "[parameters('CosmosDbMongoDb1_properties_typeProperties_database')]"
					},
					"CosmosDbMongoDb2_properties_typeProperties_database": {
						"value": "[parameters('CosmosDbMongoDb2_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}