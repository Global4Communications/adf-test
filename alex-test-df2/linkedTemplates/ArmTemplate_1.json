		{
			"name": "[concat(parameters('factoryName'), '/CosmosToTable')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "CosmosDbNoSql1",
								"type": "LinkedServiceReference"
							},
							"name": "NosqlFileRows"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "OutputJson",
								"type": "DatasetReference"
							},
							"name": "sink1",
							"rejectedDataLinkedService": {
								"referenceName": "AzureBlobStorage1",
								"type": "LinkedServiceReference"
							}
						}
					],
					"transformations": [
						{
							"name": "Dedupe",
							"description": "Select distinct values.  If multiple entries for the same UPRN are found the use the latest values for each column"
						},
						{
							"name": "AdditionalColumns"
						}
					],
					"scriptLines": [
						"source(output(",
						"          CityFibreDirect as (uprn as long, full_address as string, {_Filepath} as string, {_Filename} as string),",
						"          FreedomFibre as (uprn as long, address as string, postcode as string, town as string, {_Filepath} as string, {_Filename} as string),",
						"          Fandw as (uprn as long, address as string, postcode as string, town as string, {_Filepath} as string, {_Filename} as string),",
						"          {_PartitionKey} as string,",
						"          {_Uprn} as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     container: 'FileRows',",
						"     storeType: 'oltp',",
						"     format: 'document',",
						"     store: 'cosmosDB',",
						"     partitionBy('roundRobin', 6)) ~> NosqlFileRows",
						"NosqlFileRows aggregate(groupBy({_Uprn}),",
						"     each(match(regexMatch(name,'^[^_].*')), $$ = max($$))) ~> Dedupe",
						"Dedupe derive(id = {_Uprn},",
						"          PartitionKey = toString(mod({_Uprn}, 1000))) ~> AdditionalColumns",
						"AdditionalColumns sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     filePattern:'output-[n].json',",
						"     truncate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     saveOrder: 1) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/dataflow1')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "Fandw",
								"type": "DatasetReference"
							},
							"name": "fandw"
						},
						{
							"dataset": {
								"referenceName": "FreedomFibre",
								"type": "DatasetReference"
							},
							"name": "freedomFibre"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "OutputCsv",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "union1"
						},
						{
							"name": "select1"
						},
						{
							"name": "select2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          uprn as string,",
						"          address as string,",
						"          postcode as string,",
						"          town as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     wildcardPaths:['F&W/*'],",
						"     partitionBy('hash', 1)) ~> fandw",
						"source(output(",
						"          uprn as string,",
						"          postcode as string,",
						"          address as string,",
						"          town as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     wildcardPaths:['Freedom Fibre/*'],",
						"     partitionBy('hash', 1)) ~> freedomFibre",
						"fandw derive({_source} = \"fandw\",",
						"          {_source_info} = '{' +\r",
						"    '\"fandw\": ' + '{' + \r",
						"        '\"uprn\": \"' + escape(uprn, 'json') + '\",' +\r",
						"        '\"address\": \"' + escape(address, 'json') + '\",' +\r",
						"        '\"postcode\": \"' + escape(postcode, 'json') + '\",' +\r",
						"        '\"town\": \"' + escape(town, 'json') + '\"' +\r",
						"    '}' +\r",
						"'}',",
						"          {_uprn} = uprn) ~> derivedColumn1",
						"freedomFibre derive({_source} = \"freedomFibre\",",
						"          {_source_info} = '{' +\r",
						"    '\"freedomFibre\": ' + '{' + \r",
						"        '\"uprn\": \"' + escape(uprn, 'json') + '\",' +\r",
						"        '\"address\": \"' + escape(address, 'json') + '\",' +\r",
						"        '\"postcode\": \"' + escape(postcode, 'json') + '\",' +\r",
						"        '\"town\": \"' + escape(town, 'json') + '\"' +\r",
						"    '}' +\r",
						"'}',",
						"          {_uprn} = uprn) ~> derivedColumn2",
						"select1, select2 union(byName: true,",
						"     partitionBy('hash', 1))~> union1",
						"derivedColumn1 select(mapColumn(",
						"          {_uprn},",
						"          {_source},",
						"          {_source_info},",
						"          fandw_uprn = uprn,",
						"          fandw_address = address,",
						"          fandw_postcode = postcode,",
						"          fandw_town = town",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"derivedColumn2 select(mapColumn(",
						"          freedomFibre_uprn = uprn,",
						"          freedomFibre_postcode = postcode,",
						"          freedomFibre_address = address,",
						"          freedomFibre_town = town,",
						"          {_source},",
						"          {_source_info},",
						"          {_uprn}",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select2",
						"union1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
