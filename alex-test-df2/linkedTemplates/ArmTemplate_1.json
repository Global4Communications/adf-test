																"source": {
																	"path": "$['_uprn']"
																},
																"sink": {
																	"path": "_uprn"
																}
															},
															{
																"source": {
																	"path": "$['_test']"
																},
																"sink": {
																	"path": "_test"
																}
															}
														]
													}
